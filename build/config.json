{
  "source": ["primitives/**/*.json", "semantic/**/*.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "dist/",
      "files": [{ "destination": "tokens.css", "format": "css/variables" }]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "dist/",
      "files": [
        { "destination": "tokens.json", "format": "json/flat" },
        { "destination": "tokens.js", "format": "javascript/es6" }
      ]
    }
  }
}
